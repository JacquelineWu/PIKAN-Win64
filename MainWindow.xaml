<Window x:Class="PIKAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}"
        Width="1280" Height="780"
        MinWidth="720" MinHeight="440"
        WindowState="Maximized"
        Background="#101216"
        Foreground="#e8ecf4"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave"
        Closing="Window_Closing"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DpiChanged="Window_DpiChanged"
        SizeChanged="Window_SizeChanged">

    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <!-- 主体（顶栏已改成浮层，不再占一行：显隐时图片不会跟着上下跳） -->
            <RowDefinition Height="*" />
            <!-- 状态栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 主体 ===================== -->
        <Grid Grid.Row="0">
            <!-- 左栏宽度可被分隔条拖动（TwoWay 绑定到 ListColumnWidth，退出时记进 state.json）；
                 预览区始终保持 Grid.Column=2，拖动不会挤到它。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== 左侧：图像档案列表 ==== -->
            <Border Grid.Column="0"
                    Background="#161a21"
                    Visibility="{Binding ChromeVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 抬头：当前来源 + 张数（收起时连这行一起藏掉） -->
                    <Grid Grid.Row="0" Margin="12,10,12,6"
                          Visibility="{Binding ListHeaderVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SourceLabel}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#dfe5ef"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountLabel}"
                                   FontSize="12"
                                   Foreground="#7f88a3" />
                    </Grid>

                    <!-- 排序 / 回上层 / 选择文件夹（收起时藏掉：三个按钮要占一整行，
                         留着就违背"只剩档案名"的初衷了）。
                         原先上面还有一行完整路径，现在搬到窗口标题栏去了（PIKAN 右边），
                         左栏这一行就只放按钮。 -->
                    <WrapPanel Grid.Row="1"
                               Margin="12,0,12,8"
                               Orientation="Horizontal"
                               Visibility="{Binding ListHeaderVisibility}">
                        <Button Content="{Binding SortDirLabel}"
                                Style="{StaticResource SortButton}"
                                ToolTip="排序正序 / 倒序切换（自然序：(1) (2) (11)）"
                                Click="ActSortDir" />
                        <Button Content="↑ 回上层"
                                Style="{StaticResource SortButton}"
                                ToolTip="回到上一级目录（退格键同效）"
                                IsEnabled="{Binding CanGoUp}"
                                Click="ActUpDir" />
                        <Button Content="选择文件夹"
                                Style="{StaticResource SortButton}"
                                ToolTip="挑一个文件夹，只看这一层（子文件夹在列表里可以再点进去）"
                                Click="ActFolder" />
                    </WrapPanel>

                    <!-- 列标题：三列宽度与列表行绑的是同一组属性，永远对齐。
                         收起 / 展开按钮已经挪到左右分隔条的正中间（见下面的 ListCollapseBtn），
                         这一行只剩纯文字，收起后也能整行留着，不必再给按钮腾格子。 -->
                    <Grid Grid.Row="2" Margin="14,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding NameColWidth}" />
                            <ColumnDefinition Width="{Binding SizeColWidth}" />
                            <ColumnDefinition Width="{Binding DateColWidth}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="档案名" FontSize="10" Foreground="#6b7488" />
                        <TextBlock Grid.Column="1" Text="大小" FontSize="10" Foreground="#6b7488"
                                   HorizontalAlignment="Right"
                                   ToolTip="图片显示字节数（原始 byte）；文件夹显示内含全部文件的总容量" />
                        <TextBlock Grid.Column="2" Text="日期" FontSize="10" Foreground="#6b7488"
                                   HorizontalAlignment="Right" Margin="10,0,0,0" />
                    </Grid>

                    <!-- 档案列表：虚拟化，只为屏幕上的几行建节点 -->
                    <ListBox x:Name="FileList"
                             Grid.Row="3"
                             Margin="6,0"
                             ItemsSource="{Binding Entries}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="FileList_ScrollChanged"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             SelectionChanged="FileList_SelectionChanged"
                             PreviewMouseMove="FileList_PreviewMouseMove"
                             MouseLeave="FileList_MouseLeave"
                             SizeChanged="FileList_SizeChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 三栏：档案名 / 字节 / 日期。
                                     列宽不用 Auto —— 每一行是各自的 DataTemplate 实例，
                                     Auto 会让每行按自己的内容单独测量，列就对不齐了；
                                     这里统一绑到窗口算好的三个宽度，天然对齐且不影响虚拟化
                                     （换成 SharedSizeGroup 会逼着每一行都参与测量，虚拟化就废了）。 -->
                                <Border Padding="8,5" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="#1f2730" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding NameColWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <ColumnDefinition Width="{Binding SizeColWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <ColumnDefinition Width="{Binding DateColWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 文件名：不显示缩略图，避免为列表格白白解码上千张小图。
                                             绑 DisplayName 而非 Name：乱码名（GBK 字节被误解码）
                                             在这里显示还原后的文字；Name 仍用于实际读文件。 -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding DisplayName}"
                                                   FontSize="12"
                                                   Foreground="{Binding NameColor}"
                                                   FontWeight="{Binding Weight}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   FontSize="11"
                                                   Foreground="#7f88a3"
                                                   HorizontalAlignment="Right"
                                                   ToolTip="{Binding SizeTip}" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DateText}"
                                                   FontSize="11"
                                                   Foreground="#5a6272"
                                                   HorizontalAlignment="Right"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- 双击档案名：切全屏，再双击一次恢复。
                                     必须挂在**每一行**上：MouseDoubleClick 是 Direct 路由事件，
                                     只在被双击的那个 Control 自身触发、不冒泡，
                                     所以挂到 ListBox 上是收不到行的双击的。 -->
                                <EventSetter Event="MouseDoubleClick" Handler="FileItem_MouseDoubleClick" />
                                <!-- 容器生成 = 这一行真的进了可见范围（虚拟化只给屏幕上的行建容器）。
                                     子文件夹的容量就靠这个时机去算：滚到哪算到哪，
                                     一屏之外的目录根本不排进队列。 -->
                                <EventSetter Event="Loaded" Handler="FileItem_Loaded" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!-- 注意：绝不能在这里设 Focusable="False"。
                                     WPF 的 ListBoxItem.HandleMouseButtonDown 里是
                                     「if (可选中 && Focus()) 才通知 ListBox 选中」，
                                     Focusable=False 会让 Focus() 恒为 false，
                                     鼠标点击行就永远选不中（表现为点左边没反应）。 -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 空态：只在列表一行都没有时出现（有「..」/子文件夹/灰行时别盖住它们） -->
                    <StackPanel Grid.Row="3"
                                VerticalAlignment="Center"
                                Margin="16,0"
                                Visibility="{Binding ListEmptyVisibility}">
                        <TextBlock Text="还没有图片"
                                   FontSize="13"
                                   Foreground="#7f88a3"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ResumeHint}"
                                   FontSize="11"
                                   Foreground="#7f88a3"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding ResumeHintVisibility}" />
                        <TextBlock Text="用左栏的「选择文件夹」挑一个目录，或把鼠标移到窗口顶部唤出工具栏"
                                   FontSize="11"
                                   Foreground="#5a6272"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 左右分隔条：拖动改左栏宽度。做成透明背景 + 1px 细线，平时几乎看不见，
                 鼠标移上去再显形，免得在深底上加一条突兀的白杠。 -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding ChromeVisibility}"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE">
                <GridSplitter.Opacity>0.6</GridSplitter.Opacity>
            </GridSplitter>

            <!-- 收起 / 展开左栏的按钮：钉在分隔条的**垂直正中**，不再跟着列表抬头走。
                 ① 它比分隔条宽（18 > 5），靠左右各 -6.5 的负 Margin 对称地溢出到两边面板上：
                    Grid 里子元素「占格子」的宽度是 Width + Margin，一旦 Margin 为负，
                    18 - 13 = 5 正好等于槽宽 —— 这条槽不必为了放按钮变粗，按钮却仍有能点的面积。
                 ② Panel.ZIndex 5 是必须的：CanvasArea 排在它后面声明，同级后面画的盖前面的，
                    不给层序的话按钮右半边会被预览区那块 #5F5F5F 底色糊掉（左半边没事，
                    因为左边那块 Border 比它先声明）。
                 ③ Visibility 跟 ChromeVisibility：全屏时分隔条整个消失，按钮要一起消失。 -->
            <Button x:Name="ListCollapseBtn"
                    Grid.Column="1"
                    Panel.ZIndex="5"
                    Content="{Binding ListCollapseGlyph}"
                    ToolTip="{Binding ListCollapseTip}"
                    Click="ActToggleList"
                    Visibility="{Binding ChromeVisibility}"
                    Width="18"
                    Height="46"
                    Margin="-6.5,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="10"
                    Padding="0">
                <Button.Style>
                    <!-- 平时压暗一点，鼠标移上去才实体化，避免在两张图中间横一条抢眼的块 -->
                    <Style TargetType="Button" BasedOn="{StaticResource SortButton}">
                        <Setter Property="Opacity" Value="0.7" />
                        <Setter Property="Background" Value="#CC2A2F3A" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                                <Setter Property="Background" Value="#2A2F3A" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ==== 右侧：大图预览 ==== -->
            <Grid x:Name="CanvasArea"
                  Grid.Column="2"
                  Background="#5F5F5F"
                  UseLayoutRounding="True"
                  ClipToBounds="True"
                  SizeChanged="CanvasArea_SizeChanged"
                  MouseWheel="CanvasArea_MouseWheel"
                  MouseDown="CanvasArea_MouseDown"
                  MouseMove="CanvasArea_MouseMove"
                  MouseUp="CanvasArea_MouseUp">

                <!-- 视图层：外旋转 + 平移，内层缩放 + 镜像 -->
                <Grid x:Name="Viewport">
                    <Grid x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- 对开（两页并排）时两张图必须作为一个整体缩放：缩放挂在这层 Canvas 上，
                             原点取 0.5,0.5 = 组合矩形的中心。若各自挂在 Image 上，两页会各自围绕
                             自己的中心长大，越放越大就越往中间挤、最后叠在一起。
                             单页时 Canvas 尺寸就等于那一页的矩形，行为与改动前完全等价。
                             两个层（清晰 / 低清占位）尺寸与位置相同，只是变换不同：
                             清晰层在缩放停稳后把 zoom 烤进布局尺寸，低清层永远靠变换跟 _zoom。 -->
                        <Canvas x:Name="PagesMain"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Image x:Name="MainImage"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False" />
                            <Image x:Name="MainImageB"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   IsHitTestVisible="False" />
                        </Canvas>
                        <Canvas x:Name="PagesLow"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Image x:Name="LowImage"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   Opacity="0" />
                            <Image x:Name="LowImageB"
                                   Stretch="Uniform"
                                   IsHitTestVisible="False"
                                   Opacity="0" />
                        </Canvas>
                    </Grid>
                </Grid>

                <!-- 空态提示 -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding EmptyVisibility}">
                    <TextBlock Text="&#128247;"
                               FontSize="64"
                               Foreground="#2a2f3a"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="滚轮 / ↑ ↓ ← → 切换上一张 / 下一张"
                               FontSize="13"
                               Foreground="#5a6272"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="左键放大 50% · 右键还原 · 双击全屏 / 退出全屏"
                               FontSize="11"
                               Foreground="#454c5a"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <TextBlock Text="拖拽平移 · Ctrl + 滚轮 / + − 缩放 · F11 全屏"
                               FontSize="11"
                               Foreground="#454c5a"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- 左上角信息浮层：只显示档案名（不含副档名），尺寸 / 格式一概不显示 -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="8,6"
                        Padding="7,4"
                        MaxWidth="520"
                        Background="#CC12161C"
                        CornerRadius="5"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasImageView}">
                    <TextBlock Text="{Binding PreviewCaption}"
                               FontSize="12"
                               Foreground="#e8ecf4"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <!-- 右下角缩放角标 -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        Padding="8,4"
                        Background="#CC12161C"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasImageView}">
                    <TextBlock Text="{Binding ZoomText}" FontSize="12" Foreground="#dfe5ef" />
                </Border>

                <!-- 全屏时右上角浮出「退出全屏」：顶栏被隐藏，必须留鼠标可点的出口 -->
                <Button Content="退出全屏"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Style="{StaticResource ToolButton}"
                        Background="#CC2A2F3A"
                        Click="ActFull"
                        Visibility="{Binding FullscreenVisibility}" />
            </Grid>
        </Grid>

        <!-- ===================== 状态栏（全屏时隐藏）===================== -->
        <Border Grid.Row="1"
                Height="26"
                Background="#12161C"
                Padding="16,0"
                Visibility="{Binding ChromeVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Status}"
                           FontSize="11"
                           Foreground="#8b95a8"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CacheLabel}"
                           FontSize="11"
                           Foreground="#5a6272"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           ToolTip="后台已预载并缓存的图片：当前位置前后各 50 张，翻页时直接命中，不用等解码" />
                <TextBlock Grid.Column="2"
                           Text="{Binding GpuLine}"
                           FontSize="11"
                           Foreground="#5a6272"
                           VerticalAlignment="Center"
                           ToolTip="{Binding GpuTip}" />
            </Grid>
        </Border>

        <!-- ===================== 顶栏（浮层）=====================
             默认隐藏，鼠标移到窗口顶部才浮出。做成浮层而不是让它占一行的原因是：
             占位行一显一隐会把下方图片区域整块挤动（鼠标刚移出顶部，画面就一跳），
             盖在内容之上则只有这一条自己动，预览尺寸完全不受影响。 -->
        <Border x:Name="TopBar"
                Grid.Row="0"
                Height="52"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Background="#F21a1d23"
                BorderBrush="#2a2f3a"
                BorderThickness="0,0,0,1"
                Padding="16,0,12,0"
                Visibility="{Binding TopBarVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PIKAN" FontSize="16" FontWeight="Bold" Foreground="#f2f5fa" />
                    <TextBlock Text="·" FontSize="14" Foreground="#4a5262" Margin="8,0" />
                    <TextBlock Text="{Binding CurName}"
                               FontSize="13"
                               Foreground="#9fb0c8"
                               VerticalAlignment="Center"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="选项" Style="{StaticResource ToolButton}" Margin="7,3,3,3" Click="ActOptions" />
                    <Button Content="全屏" Style="{StaticResource ToolButton}" Click="ActFull" />
                    <Button Content="{Binding SlideLabel}"
                            Style="{StaticResource ToolButton}"
                            Background="{Binding SlideBackground}"
                            Foreground="{Binding SlideForeground}"
                            Margin="7,3,3,3"
                            Click="ActSlide" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 悬停缩略图 =====================
             鼠标停在左侧档案名上时，在鼠标旁边浮出这张图的小图。
             图优先取自预载缓存（当前位置前后各 50 张已经解码好了，鼠标一到图就出来），
             没命中才后台解一张 384 边长的小图——不打断翻页，也不挤占主缓存。
             用 Popup 而不是 Grid 内浮层：它能探出窗口边界，也不会被列表裁掉。 -->
        <Popup x:Name="HoverThumb"
               AllowsTransparency="True"
               IsHitTestVisible="False"
               StaysOpen="True"
               Placement="Absolute">
            <Border x:Name="HoverThumbBox"
                    Background="#F2161A21"
                    BorderBrush="#3a4250"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6">
                <StackPanel>
                    <Image x:Name="HoverThumbImage"
                           Stretch="Uniform"
                           MaxWidth="220"
                           MaxHeight="220"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="HoverThumbLabel"
                               FontSize="11"
                               Foreground="#8b95a8"
                               MaxWidth="220"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
