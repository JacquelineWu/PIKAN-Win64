<Window x:Class="PIKAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIKAN"
        Width="1280" Height="780"
        MinWidth="720" MinHeight="440"
        WindowState="Maximized"
        Background="#101216"
        Foreground="#e8ecf4"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <!-- 顶栏 -->
            <RowDefinition Height="Auto" />
            <!-- 主体 -->
            <RowDefinition Height="*" />
            <!-- 状态栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 顶栏（全屏时整条隐藏）===================== -->
        <Border Grid.Row="0"
                Height="52"
                Background="#1a1d23"
                BorderBrush="#2a2f3a"
                BorderThickness="0,0,0,1"
                Padding="16,0,12,0"
                Visibility="{Binding ChromeVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PIKAN" FontSize="16" FontWeight="Bold" Foreground="#f2f5fa" />
                    <TextBlock Text="·" FontSize="14" Foreground="#4a5262" Margin="8,0" />
                    <TextBlock Text="{Binding CurName}"
                               FontSize="13"
                               Foreground="#9fb0c8"
                               VerticalAlignment="Center"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开图库" Style="{StaticResource ToolButton}" Click="ActGallery" />
                    <Button Content="选择图片" Style="{StaticResource ToolButton}" Click="ActFiles" />
                    <Button Content="选择文件夹" Style="{StaticResource ToolButton}" Click="ActFolder" />
                    <Button Content="回到上次" Style="{StaticResource ToolButton}" Click="ActResume" />
                    <Button Content="全屏" Style="{StaticResource ToolButton}" Click="ActFull" />
                    <Button Content="{Binding SlideLabel}"
                            Style="{StaticResource ToolButton}"
                            Background="{Binding SlideBackground}"
                            Foreground="{Binding SlideForeground}"
                            Margin="7,3,3,3"
                            Click="ActSlide" />
                    <Button Content="{Binding GpuLabel}"
                            Style="{StaticResource ToolButton}"
                            Background="{Binding GpuBackground}"
                            Foreground="{Binding GpuForeground}"
                            Margin="7,3,3,3"
                            ToolTip="{Binding GpuTip}"
                            Click="ActGpu" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 主体 ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== 左侧：图像档案列表 ==== -->
            <Border Grid.Column="0"
                    Width="280"
                    Background="#161a21"
                    Visibility="{Binding ChromeVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 列表抬头 -->
                    <Grid Grid.Row="0" Margin="12,10,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SourceLabel}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#dfe5ef"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountLabel}"
                                   FontSize="12"
                                   Foreground="#7f88a3" />
                    </Grid>

                    <!-- 档案列表：虚拟化，只为屏幕上的几行建节点 -->
                    <ListBox x:Name="FileList"
                             Grid.Row="1"
                             Margin="6,0"
                             ItemsSource="{Binding Items}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             SelectionChanged="FileList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="6" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="#1f2730" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 缩略图：未就绪时是深灰占位块，绝不按原图分辨率解码 -->
                                        <Border Grid.Column="0"
                                                Width="56" Height="42"
                                                CornerRadius="4"
                                                Background="#262b34"
                                                ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="BorderBrush" Value="#4fd1c5" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="BorderThickness" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       Foreground="#9fb0c8"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Ext}" FontSize="10" Foreground="#5a6272" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="10" Foreground="#7f88a8" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <EventSetter Event="Loaded" Handler="FileItem_Loaded" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 空态 -->
                    <StackPanel Grid.Row="1"
                                VerticalAlignment="Center"
                                Margin="16,0"
                                Visibility="{Binding EmptyVisibility}">
                        <TextBlock Text="还没有图片"
                                   FontSize="13"
                                   Foreground="#7f88a3"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ResumeHint}"
                                   FontSize="11"
                                   Foreground="#7f88a3"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding ResumeHintVisibility}" />
                        <TextBlock Text="点顶栏「打开图库」扫描图片库，或「选择图片」挑文件"
                                   FontSize="11"
                                   Foreground="#5a6272"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==== 右侧：大图预览 ==== -->
            <Grid x:Name="CanvasArea"
                  Grid.Column="1"
                  Background="#0a0b0d"
                  ClipToBounds="True"
                  SizeChanged="CanvasArea_SizeChanged"
                  MouseWheel="CanvasArea_MouseWheel"
                  MouseDown="CanvasArea_MouseDown"
                  MouseMove="CanvasArea_MouseMove"
                  MouseUp="CanvasArea_MouseUp">

                <!-- 视图层：外旋转 + 平移，内层缩放 + 镜像 -->
                <Grid x:Name="Viewport">
                    <Grid x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="MainImage"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               IsHitTestVisible="False" />
                        <Image x:Name="LowImage"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5"
                               IsHitTestVisible="False"
                               Opacity="0" />
                    </Grid>
                </Grid>

                <!-- 空态提示 -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding EmptyVisibility}">
                    <TextBlock Text="&#128247;"
                               FontSize="64"
                               Foreground="#2a2f3a"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="滚轮切换上一张 / 下一张"
                               FontSize="13"
                               Foreground="#5a6272"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="左键放大 50% · 右键放大 100% · 拖拽平移"
                               FontSize="11"
                               Foreground="#454c5a"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <TextBlock Text="双击复位 · Ctrl + 滚轮缩放 · F11 全屏"
                               FontSize="11"
                               Foreground="#454c5a"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- 左上角信息浮层 -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="8"
                        MaxWidth="380"
                        Background="#CC12161C"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasImageView}">
                    <StackPanel>
                        <TextBlock Text="{Binding CurName}"
                                   FontSize="12"
                                   Foreground="#e8ecf4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding InfoLine}"
                                   FontSize="11"
                                   Foreground="#8b95a8"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 右下角缩放角标 -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        Padding="8,4"
                        Background="#CC12161C"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasImageView}">
                    <TextBlock Text="{Binding ZoomText}" FontSize="12" Foreground="#dfe5ef" />
                </Border>

                <!-- 全屏时右上角浮出「退出全屏」：顶栏被隐藏，必须留鼠标可点的出口 -->
                <Button Content="退出全屏"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Style="{StaticResource ToolButton}"
                        Background="#CC2A2F3A"
                        Click="ActFull"
                        Visibility="{Binding FullscreenVisibility}" />
            </Grid>
        </Grid>

        <!-- ===================== 状态栏（全屏时隐藏）===================== -->
        <Border Grid.Row="2"
                Height="26"
                Background="#12161C"
                Padding="16,0"
                Visibility="{Binding ChromeVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Status}"
                           FontSize="11"
                           Foreground="#8b95a8"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CacheLabel}"
                           FontSize="11"
                           Foreground="#5a6272"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           ToolTip="后台已预载并缓存的图片：当前位置前后各 20 张，翻页时直接命中，不用等解码" />
                <TextBlock Grid.Column="2"
                           Text="{Binding GpuLine}"
                           FontSize="11"
                           Foreground="#5a6272"
                           VerticalAlignment="Center"
                           ToolTip="{Binding GpuTip}" />
            </Grid>
        </Border>
    </Grid>
</Window>
