<Window x:Class="PIKAN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PIKAN"
        Width="1280" Height="780"
        MinWidth="720" MinHeight="440"
        WindowState="Maximized"
        Background="#101216"
        Foreground="#e8ecf4"
        FontFamily="Segoe UI"
        AllowDrop="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseMove="Window_PreviewMouseMove"
        MouseLeave="Window_MouseLeave"
        Closing="Window_Closing"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        DpiChanged="Window_DpiChanged">

    <Grid SnapsToDevicePixels="True">
        <Grid.RowDefinitions>
            <!-- 主体（顶栏已改成浮层，不再占一行：显隐时图片不会跟着上下跳） -->
            <RowDefinition Height="*" />
            <!-- 状态栏 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== 主体 ===================== -->
        <Grid Grid.Row="0">
            <!-- 左栏宽度可被分隔条拖动（TwoWay 绑定到 ListColumnWidth，退出时记进 state.json）；
                 预览区始终保持 Grid.Column=2，拖动不会挤到它。 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding ListColumnWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==== 左侧：图像档案列表 ==== -->
            <Border Grid.Column="0"
                    Background="#161a21"
                    Visibility="{Binding ChromeVisibility}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 抬头：当前来源 + 张数 -->
                    <Grid Grid.Row="0" Margin="12,10,12,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding SourceLabel}"
                                   FontSize="13"
                                   FontWeight="Bold"
                                   Foreground="#dfe5ef"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CountLabel}"
                                   FontSize="12"
                                   Foreground="#7f88a3" />
                    </Grid>

                    <!-- 当前目录 + 排序控件 -->
                    <Grid Grid.Row="1" Margin="12,0,12,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding DirLabel}"
                                   FontSize="11"
                                   Foreground="#6b7488"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DirLabel}"
                                   Margin="0,0,0,6" />

                        <!-- 窄栏（最小 260）时三个按钮放不下一行，用 WrapPanel 自动换行 -->
                        <WrapPanel Grid.Row="1" Orientation="Horizontal">
                            <Button Content="{Binding SortDirLabel}"
                                    Style="{StaticResource SortButton}"
                                    ToolTip="名称正序 / 倒序切换（自然序：(1) (2) (11)）"
                                    Click="ActSortDir" />
                            <Button Content="↑ 上级"
                                    Style="{StaticResource SortButton}"
                                    ToolTip="回到上一级目录（退格键同效）"
                                    IsEnabled="{Binding CanGoUp}"
                                    Click="ActUpDir" />
                            <Button Content="选择文件夹"
                                    Style="{StaticResource SortButton}"
                                    ToolTip="挑一个文件夹，只看这一层（子文件夹在列表里可以再点进去）"
                                    Click="ActFolder" />
                        </WrapPanel>
                    </Grid>

                    <!-- 列标题：三列宽度与列表行绑的是同一组属性，永远对齐 -->
                    <Grid Grid.Row="2" Margin="14,0,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding NameColWidth}" />
                            <ColumnDefinition Width="{Binding SizeColWidth}" />
                            <ColumnDefinition Width="{Binding DateColWidth}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="档案名" FontSize="10" Foreground="#6b7488" />
                        <TextBlock Grid.Column="1" Text="大小" FontSize="10" Foreground="#6b7488"
                                   HorizontalAlignment="Right"
                                   ToolTip="图片显示字节数（原始 byte）；文件夹显示内含全部文件的总容量" />
                        <TextBlock Grid.Column="2" Text="日期" FontSize="10" Foreground="#6b7488"
                                   HorizontalAlignment="Right" Margin="10,0,0,0" />
                    </Grid>

                    <!-- 档案列表：虚拟化，只为屏幕上的几行建节点 -->
                    <ListBox x:Name="FileList"
                             Grid.Row="3"
                             Margin="6,0"
                             ItemsSource="{Binding Entries}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.ScrollChanged="FileList_ScrollChanged"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Standard"
                             SelectionChanged="FileList_SelectionChanged"
                             PreviewMouseMove="FileList_PreviewMouseMove"
                             MouseLeave="FileList_MouseLeave"
                             SizeChanged="FileList_SizeChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 三栏：档案名 / 字节 / 日期。
                                     列宽不用 Auto —— 每一行是各自的 DataTemplate 实例，
                                     Auto 会让每行按自己的内容单独测量，列就对不齐了；
                                     这里统一绑到窗口算好的三个宽度，天然对齐且不影响虚拟化
                                     （换成 SharedSizeGroup 会逼着每一行都参与测量，虚拟化就废了）。 -->
                                <Border Padding="8,5" CornerRadius="6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="Background" Value="#1f2730" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding NameColWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <ColumnDefinition Width="{Binding SizeColWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <ColumnDefinition Width="{Binding DateColWidth, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 文件名：不显示缩略图，避免为列表格白白解码上千张小图 -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="{Binding NameColor}"
                                                   FontWeight="{Binding Weight}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   FontSize="11"
                                                   Foreground="#7f88a3"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DateText}"
                                                   FontSize="11"
                                                   Foreground="#5a6272"
                                                   HorizontalAlignment="Right"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <!-- 注意：绝不能在这里设 Focusable="False"。
                                     WPF 的 ListBoxItem.HandleMouseButtonDown 里是
                                     「if (可选中 && Focus()) 才通知 ListBox 选中」，
                                     Focusable=False 会让 Focus() 恒为 false，
                                     鼠标点击行就永远选不中（表现为点左边没反应）。 -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent" SnapsToDevicePixels="True">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- 空态：只在列表一行都没有时出现（有「..」/子文件夹/灰行时别盖住它们） -->
                    <StackPanel Grid.Row="3"
                                VerticalAlignment="Center"
                                Margin="16,0"
                                Visibility="{Binding ListEmptyVisibility}">
                        <TextBlock Text="还没有图片"
                                   FontSize="13"
                                   Foreground="#7f88a3"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{Binding ResumeHint}"
                                   FontSize="11"
                                   Foreground="#7f88a3"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding ResumeHintVisibility}" />
                        <TextBlock Text="鼠标移到窗口顶部唤出工具栏：点「打开图库」扫描图片库，或「选择图片」挑文件"
                                   FontSize="11"
                                   Foreground="#5a6272"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 左右分隔条：拖动改左栏宽度。做成透明背景 + 1px 细线，平时几乎看不见，
                 鼠标移上去再显形，免得在深底上加一条突兀的白杠。 -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          Visibility="{Binding ChromeVisibility}"
                          ResizeBehavior="PreviousAndNext"
                          ShowsPreview="False"
                          Cursor="SizeWE">
                <GridSplitter.Opacity>0.6</GridSplitter.Opacity>
            </GridSplitter>

            <!-- ==== 右侧：大图预览 ==== -->
            <Grid x:Name="CanvasArea"
                  Grid.Column="2"
                  Background="#5F5F5F"
                  UseLayoutRounding="True"
                  ClipToBounds="True"
                  SizeChanged="CanvasArea_SizeChanged"
                  MouseWheel="CanvasArea_MouseWheel"
                  MouseDown="CanvasArea_MouseDown"
                  MouseMove="CanvasArea_MouseMove"
                  MouseUp="CanvasArea_MouseUp">

                <!-- 视图层：外旋转 + 平移，内层缩放 + 镜像 -->
                <Grid x:Name="Viewport">
                    <Grid x:Name="Frame" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Image x:Name="MainImage"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               IsHitTestVisible="False" />
                        <Image x:Name="LowImage"
                               Stretch="Uniform"
                               RenderTransformOrigin="0.5,0.5"
                               IsHitTestVisible="False"
                               Opacity="0" />
                    </Grid>
                </Grid>

                <!-- 空态提示 -->
                <StackPanel VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="{Binding EmptyVisibility}">
                    <TextBlock Text="&#128247;"
                               FontSize="64"
                               Foreground="#2a2f3a"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="滚轮 / ↑ ↓ ← → 切换上一张 / 下一张"
                               FontSize="13"
                               Foreground="#5a6272"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />
                    <TextBlock Text="左键放大 50% · 右键放大 100% · 拖拽平移"
                               FontSize="11"
                               Foreground="#454c5a"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                    <TextBlock Text="双击复位 · Ctrl + 滚轮 / + − 缩放 · F11 全屏"
                               FontSize="11"
                               Foreground="#454c5a"
                               HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>

                <!-- 左上角信息浮层 -->
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Margin="12"
                        Padding="8"
                        MaxWidth="380"
                        Background="#CC12161C"
                        CornerRadius="6"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasImageView}">
                    <StackPanel>
                        <TextBlock Text="{Binding CurName}"
                                   FontSize="12"
                                   Foreground="#e8ecf4"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding InfoLine}"
                                   FontSize="11"
                                   Foreground="#8b95a8"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- 右下角缩放角标 -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="12"
                        Padding="8,4"
                        Background="#CC12161C"
                        CornerRadius="4"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasImageView}">
                    <TextBlock Text="{Binding ZoomText}" FontSize="12" Foreground="#dfe5ef" />
                </Border>

                <!-- 全屏时右上角浮出「退出全屏」：顶栏被隐藏，必须留鼠标可点的出口 -->
                <Button Content="退出全屏"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="12"
                        Style="{StaticResource ToolButton}"
                        Background="#CC2A2F3A"
                        Click="ActFull"
                        Visibility="{Binding FullscreenVisibility}" />
            </Grid>
        </Grid>

        <!-- ===================== 状态栏（全屏时隐藏）===================== -->
        <Border Grid.Row="1"
                Height="26"
                Background="#12161C"
                Padding="16,0"
                Visibility="{Binding ChromeVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Status}"
                           FontSize="11"
                           Foreground="#8b95a8"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CacheLabel}"
                           FontSize="11"
                           Foreground="#5a6272"
                           Margin="0,0,16,0"
                           VerticalAlignment="Center"
                           ToolTip="后台已预载并缓存的图片：当前位置前后各 20 张，翻页时直接命中，不用等解码" />
                <TextBlock Grid.Column="2"
                           Text="{Binding GpuLine}"
                           FontSize="11"
                           Foreground="#5a6272"
                           VerticalAlignment="Center"
                           ToolTip="{Binding GpuTip}" />
            </Grid>
        </Border>

        <!-- ===================== 顶栏（浮层）=====================
             默认隐藏，鼠标移到窗口顶部才浮出。做成浮层而不是让它占一行的原因是：
             占位行一显一隐会把下方图片区域整块挤动（鼠标刚移出顶部，画面就一跳），
             盖在内容之上则只有这一条自己动，预览尺寸完全不受影响。 -->
        <Border x:Name="TopBar"
                Grid.Row="0"
                Height="52"
                VerticalAlignment="Top"
                Panel.ZIndex="10"
                Background="#F21a1d23"
                BorderBrush="#2a2f3a"
                BorderThickness="0,0,0,1"
                Padding="16,0,12,0"
                Visibility="{Binding TopBarVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="PIKAN" FontSize="16" FontWeight="Bold" Foreground="#f2f5fa" />
                    <TextBlock Text="·" FontSize="14" Foreground="#4a5262" Margin="8,0" />
                    <TextBlock Text="{Binding CurName}"
                               FontSize="13"
                               Foreground="#9fb0c8"
                               VerticalAlignment="Center"
                               MaxWidth="420"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="打开图库" Style="{StaticResource ToolButton}" Click="ActGallery" />
                    <Button Content="选择图片" Style="{StaticResource ToolButton}" Click="ActFiles" />
                    <Button Content="回到上次" Style="{StaticResource ToolButton}" Click="ActResume" />
                    <Button Content="选项" Style="{StaticResource ToolButton}" Margin="7,3,3,3" Click="ActOptions" />
                    <Button Content="全屏" Style="{StaticResource ToolButton}" Click="ActFull" />
                    <Button Content="{Binding SlideLabel}"
                            Style="{StaticResource ToolButton}"
                            Background="{Binding SlideBackground}"
                            Foreground="{Binding SlideForeground}"
                            Margin="7,3,3,3"
                            Click="ActSlide" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 悬停缩略图 =====================
             鼠标停在左侧档案名上时，在鼠标旁边浮出这张图的小图。
             图优先取自预载缓存（当前位置前后各 20 张已经解码好了），
             没命中才后台解一张 384 边长的小图——不打断翻页，也不挤占主缓存。
             用 Popup 而不是 Grid 内浮层：它能探出窗口边界，也不会被列表裁掉。 -->
        <Popup x:Name="HoverThumb"
               AllowsTransparency="True"
               IsHitTestVisible="False"
               StaysOpen="True"
               Placement="Absolute">
            <Border x:Name="HoverThumbBox"
                    Background="#F2161A21"
                    BorderBrush="#3a4250"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="6">
                <StackPanel>
                    <Image x:Name="HoverThumbImage"
                           Stretch="Uniform"
                           MaxWidth="220"
                           MaxHeight="220"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="HoverThumbLabel"
                               FontSize="11"
                               Foreground="#8b95a8"
                               MaxWidth="220"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
