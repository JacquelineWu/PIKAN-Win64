    @%p1 bra $L_EXIT5;
    setp.ge.u32 %p2, %r11, %r2;
    @%p2 bra $L_EXIT5;

    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    mov.f32 %f4, 0f00000000;

    mov.s32 %r14, 0;
    sub.s32 %r14, %r14, %r3;
$L_LOOP_K2:
    setp.gt.s32 %p3, %r14, %r3;
    @%p3 bra $L_END_K2;

    add.s32 %r15, %r11, %r14;            // y + k
    setp.lt.s32 %p4, %r15, 0;
    @%p4 mov.u32 %r15, 0;
    sub.u32 %r16, %r2, 1;
    setp.gt.u32 %p5, %r15, %r16;
    @%p5 mov.u32 %r15, %r16;

    add.s32 %r17, %r14, %r3;
    mul.wide.s32 %rd4, %r17, 4;
    add.u64 %rd4, %rd3, %rd4;
    ld.global.f32 %f5, [%rd4];

    mul.lo.u32 %r18, %r15, %r1;
    add.u32 %r18, %r18, %r7;
    mul.wide.u32 %rd5, %r18, 4;
    add.u64 %rd5, %rd1, %rd5;
    ld.global.v4.u8 {%rb1, %rb2, %rb3, %rb4}, [%rd5];
    cvt.u32.u8 %r20, %rb1;
    cvt.u32.u8 %r21, %rb2;
    cvt.u32.u8 %r22, %rb3;
    cvt.u32.u8 %r23, %rb4;
    cvt.rn.f32.u32 %f6, %r20;
    cvt.rn.f32.u32 %f7, %r21;
    cvt.rn.f32.u32 %f8, %r22;
    cvt.rn.f32.u32 %f9, %r23;

    fma.rn.f32 %f1, %f6, %f5, %f1;
    fma.rn.f32 %f2, %f7, %f5, %f2;
    fma.rn.f32 %f3, %f8, %f5, %f3;
    fma.rn.f32 %f4, %f9, %f5, %f4;

    add.s32 %r14, %r14, 1;
    bra $L_LOOP_K2;
$L_END_K2:

    mul.lo.u32 %r24, %r11, %r1;
    add.u32 %r24, %r24, %r7;
    mul.wide.u32 %rd6, %r24, 4;
    add.u64 %rd6, %rd2, %rd6;

    max.f32 %f1, %f1, 0f00000000;
    min.f32 %f1, %f1, 0f437F0000;
    max.f32 %f2, %f2, 0f00000000;
    min.f32 %f2, %f2, 0f437F0000;
    max.f32 %f3, %f3, 0f00000000;
    min.f32 %f3, %f3, 0f437F0000;
    max.f32 %f4, %f4, 0f00000000;
    min.f32 %f4, %f4, 0f437F0000;

    cvt.rni.u32.f32 %r25, %f1;
    cvt.rni.u32.f32 %r26, %f2;
    cvt.rni.u32.f32 %r27, %f3;
    cvt.rni.u32.f32 %r28, %f4;
    cvt.u8.u32 %rb1, %r25;
    cvt.u8.u32 %rb2, %r26;
    cvt.u8.u32 %rb3, %r27;
    cvt.u8.u32 %rb4, %r28;
    st.global.v4.u8 [%rd6], {%rb1, %rb2, %rb3, %rb4};

$L_EXIT5:
