.version 8.5
.target sm_86
.address_size 64

// ===== 基础设施自检：每个 int32 乘 2 =====
.visible .entry scale2(
    .param .u64 p_in,
    .param .u64 p_out,
    .param .u32 p_n
)
{
    .reg .pred %p<2>;
    .reg .u32 %r<8>;
    .reg .u64 %rd<8>;

    ld.param.u64 %rd1, [p_in];
    ld.param.u64 %rd2, [p_out];
    ld.param.u32 %r1, [p_n];

    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %ctaid.x;
    mov.u32 %r4, %tid.x;
    mad.lo.u32 %r5, %r2, %r3, %r4;

    setp.ge.u32 %p1, %r5, %r1;
    @%p1 bra $L_EXIT1;

    mul.wide.u32 %rd3, %r5, 4;
    add.u64 %rd4, %rd1, %rd3;
    add.u64 %rd5, %rd2, %rd3;
    ld.global.u32 %r6, [%rd4];
    add.u32 %r7, %r6, %r6;
    st.global.u32 [%rd5], %r7;

$L_EXIT1:
    ret;
}

// ===== 双线性重采样（兜底 kernel） =====
.visible .entry resize_bilinear(
    .param .u64 p_in,
    .param .u64 p_out,
    .param .u32 p_iw,
    .param .u32 p_ih,
    .param .u32 p_ow,
    .param .u32 p_oh
)
{
    .reg .pred %p<12>;
    .reg .u32 %r<48>;
    .reg .u64 %rd<24>;
    .reg .f32 %f<48>;

    ld.param.u64 %rd1, [p_in];
    ld.param.u64 %rd2, [p_out];
    ld.param.u32 %r1, [p_iw];
    ld.param.u32 %r2, [p_ih];
    ld.param.u32 %r3, [p_ow];
    ld.param.u32 %r4, [p_oh];

    mov.u32 %r5, %ntid.x;
    mov.u32 %r6, %ctaid.x;
    mov.u32 %r7, %tid.x;
    mad.lo.u32 %r8, %r5, %r6, %r7;

    mov.u32 %r9, %ntid.y;
    mov.u32 %r10, %ctaid.y;
    mov.u32 %r11, %tid.y;
    mad.lo.u32 %r12, %r9, %r10, %r11;

    setp.ge.u32 %p1, %r8, %r3;
    @%p1 bra $L_EXIT2;
    setp.ge.u32 %p2, %r12, %r4;
    @%p2 bra $L_EXIT2;

    cvt.rn.f32.u32 %f1, %r1;
    cvt.rn.f32.u32 %f2, %r3;
    div.rn.f32 %f3, %f1, %f2;

    cvt.rn.f32.u32 %f4, %r2;
    cvt.rn.f32.u32 %f5, %r4;
    div.rn.f32 %f6, %f4, %f5;

    cvt.rn.f32.u32 %f7, %r8;
    add.f32 %f7, %f7, 0f3F000000;
    mul.f32 %f7, %f7, %f3;
    sub.f32 %f7, %f7, 0f3F000000;

    cvt.rn.f32.u32 %f8, %r12;
    add.f32 %f8, %f8, 0f3F000000;
    mul.f32 %f8, %f8, %f6;
    sub.f32 %f8, %f8, 0f3F000000;

    cvt.rmi.s32.f32 %r13, %f7;
    cvt.rn.f32.s32 %f9, %r13;
    sub.f32 %f10, %f7, %f9;

    cvt.rmi.s32.f32 %r15, %f8;
    cvt.rn.f32.s32 %f11, %r15;
    sub.f32 %f12, %f8, %f11;

    setp.lt.s32 %p3, %r13, 0;
    @%p3 mov.u32 %r13, 0;
    sub.u32 %r20, %r1, 1;
    setp.gt.u32 %p4, %r13, %r20;
    @%p4 mov.u32 %r13, %r20;

    add.u32 %r14, %r13, 1;
    setp.gt.u32 %p5, %r14, %r20;
    @%p5 mov.u32 %r14, %r20;

    setp.lt.s32 %p6, %r15, 0;
    @%p6 mov.u32 %r15, 0;
    sub.u32 %r21, %r2, 1;
    setp.gt.u32 %p7, %r15, %r21;
    @%p7 mov.u32 %r15, %r21;

    add.u32 %r16, %r15, 1;
    setp.gt.u32 %p8, %r16, %r21;
    @%p8 mov.u32 %r16, %r21;

    mul.lo.u32 %r22, %r15, %r1;
    mul.lo.u32 %r23, %r16, %r1;

    add.u32 %r24, %r22, %r13;
    mul.wide.u32 %rd4, %r24, 4;
    add.u64 %rd4, %rd1, %rd4;

    add.u32 %r25, %r22, %r14;
    mul.wide.u32 %rd5, %r25, 4;
    add.u64 %rd5, %rd1, %rd5;

    add.u32 %r26, %r23, %r13;
    mul.wide.u32 %rd6, %r26, 4;
    add.u64 %rd6, %rd1, %rd6;

    add.u32 %r27, %r23, %r14;
    mul.wide.u32 %rd7, %r27, 4;
    add.u64 %rd7, %rd1, %rd7;

    mul.lo.u32 %r28, %r12, %r3;
    add.u32 %r28, %r28, %r8;
    mul.wide.u32 %rd8, %r28, 4;
    add.u64 %rd8, %rd2, %rd8;

    mov.u32 %r29, 0;
$L_LOOP_C:
    setp.ge.u32 %p9, %r29, 4;
    @%p9 bra $L_END_C;
    cvt.u64.u32 %rd9, %r29;

    add.u64 %rd10, %rd4, %rd9;
    ld.global.u8 %r30, [%rd10];
    cvt.rn.f32.u32 %f20, %r30;

    add.u64 %rd10, %rd5, %rd9;
    ld.global.u8 %r31, [%rd10];
    cvt.rn.f32.u32 %f21, %r31;

    add.u64 %rd10, %rd6, %rd9;
    ld.global.u8 %r32, [%rd10];
    cvt.rn.f32.u32 %f22, %r32;

    add.u64 %rd10, %rd7, %rd9;
    ld.global.u8 %r33, [%rd10];
    cvt.rn.f32.u32 %f23, %r33;

    sub.f32 %f24, 0f3F800000, %f10;
    sub.f32 %f25, 0f3F800000, %f12;

    mul.f32 %f26, %f20, %f24;
    mul.f32 %f26, %f26, %f25;
    mul.f32 %f27, %f21, %f10;
    mul.f32 %f27, %f27, %f25;
    mul.f32 %f28, %f22, %f24;
    mul.f32 %f28, %f28, %f12;
    mul.f32 %f29, %f23, %f10;
    mul.f32 %f29, %f29, %f12;

    add.f32 %f30, %f26, %f27;
    add.f32 %f30, %f30, %f28;
    add.f32 %f30, %f30, %f29;
    cvt.rni.u32.f32 %r34, %f30;

    add.u64 %rd11, %rd8, %rd9;
    st.global.u8 [%rd11], %r34;

    add.u32 %r29, %r29, 1;
    bra $L_LOOP_C;
$L_END_C:

$L_EXIT2:
    ret;
}

// ===== Mitchell-Netravali 重采样（area sampling，每方向最多 16 taps） =====
.visible .entry resize_mitchell(
    .param .u64 p_in,
    .param .u64 p_out,
    .param .u32 p_iw,
    .param .u32 p_ih,
    .param .u32 p_ow,
    .param .u32 p_oh
)
{
    .reg .pred %p<24>;
    .reg .u32 %r<64>;
    .reg .u64 %rd<24>;
    .reg .f32 %f<64>;
    .reg .b8 %rb<8>;

    ld.param.u64 %rd1, [p_in];
    ld.param.u64 %rd2, [p_out];
    ld.param.u32 %r1, [p_iw];
    ld.param.u32 %r2, [p_ih];
    ld.param.u32 %r3, [p_ow];
    ld.param.u32 %r4, [p_oh];

    mov.u32 %r5, %ntid.x;
    mov.u32 %r6, %ctaid.x;
    mov.u32 %r7, %tid.x;
    mad.lo.u32 %r8, %r5, %r6, %r7;

    mov.u32 %r9, %ntid.y;
    mov.u32 %r10, %ctaid.y;
    mov.u32 %r11, %tid.y;
    mad.lo.u32 %r12, %r9, %r10, %r11;

    setp.ge.u32 %p1, %r8, %r3;
    @%p1 bra $L_EXIT3;
    setp.ge.u32 %p2, %r12, %r4;
    @%p2 bra $L_EXIT3;

    // sx = iw/ow, sy = ih/oh
    cvt.rn.f32.u32 %f1, %r1;
    cvt.rn.f32.u32 %f2, %r3;
    div.rn.f32 %f3, %f1, %f2;
    cvt.rn.f32.u32 %f4, %r2;
    cvt.rn.f32.u32 %f5, %r4;
    div.rn.f32 %f6, %f4, %f5;

    // fsx = max(sx, 1.0), fsy = max(sy, 1.0)
    mov.f32 %f7, %f3;
    setp.lt.f32 %p3, %f7, 0f3F800000;
    @%p3 mov.f32 %f7, 0f3F800000;
    mov.f32 %f8, %f6;
    setp.lt.f32 %p4, %f8, 0f3F800000;
    @%p4 mov.f32 %f8, 0f3F800000;

    // xc = (x + 0.5) * sx - 0.5, yc = (y + 0.5) * sy - 0.5
    cvt.rn.f32.u32 %f9, %r8;
    add.f32 %f9, %f9, 0f3F000000;
    mul.f32 %f9, %f9, %f3;
    sub.f32 %f9, %f9, 0f3F000000;

    cvt.rn.f32.u32 %f10, %r12;
    add.f32 %f10, %f10, 0f3F000000;
    mul.f32 %f10, %f10, %f6;
    sub.f32 %f10, %f10, 0f3F000000;

    // halfx = 2*fsx, halfy = 2*fsy
    add.f32 %f11, %f7, %f7;
    add.f32 %f12, %f8, %f8;

    // xlo = floor(xc - halfx), xhi = ceil(xc + halfx)
    sub.f32 %f13, %f9, %f11;
    cvt.rmi.s32.f32 %r13, %f13;
    add.f32 %f14, %f9, %f11;
    cvt.rpi.s32.f32 %r14, %f14;

    sub.f32 %f15, %f10, %f12;
    cvt.rmi.s32.f32 %r15, %f15;
    add.f32 %f16, %f10, %f12;
    cvt.rpi.s32.f32 %r16, %f16;

    // nx = xhi - xlo + 1, ny = yhi - ylo + 1
    sub.s32 %r17, %r14, %r13;
    add.s32 %r17, %r17, 1;
    sub.s32 %r18, %r16, %r15;
    add.s32 %r18, %r18, 1;

    // taps 上限 16：超了就以中心为锚重新开窗
    setp.gt.s32 %p5, %r17, 16;
    @%p5 bra $L_CAPX;
    bra $L_NOCAPX;
$L_CAPX:
    cvt.rni.s32.f32 %r19, %f9;
    sub.s32 %r13, %r19, 8;
    mov.u32 %r17, 16;
$L_NOCAPX:

    setp.gt.s32 %p6, %r18, 16;
    @%p6 bra $L_CAPY;
    bra $L_NOCAPY;
$L_CAPY:
    cvt.rni.s32.f32 %r20, %f10;
    sub.s32 %r15, %r20, 8;
    mov.u32 %r18, 16;
$L_NOCAPY:

    // 输出地址
    mul.lo.u32 %r21, %r12, %r3;
    add.u32 %r21, %r21, %r8;
    mul.wide.u32 %rd3, %r21, 4;
    add.u64 %rd3, %rd2, %rd3;

    mov.f32 %f20, 0f00000000;   // accR
    mov.f32 %f21, 0f00000000;   // accG
    mov.f32 %f22, 0f00000000;   // accB
    mov.f32 %f23, 0f00000000;   // accA
    mov.f32 %f24, 0f00000000;   // wsum

    mov.u32 %r22, 0;            // j
$L_LOOP_J:
    setp.ge.s32 %p7, %r22, %r18;
    @%p7 bra $L_END_J;

    // ---- wy ----
    add.s32 %r23, %r15, %r22;
    cvt.rn.f32.s32 %f25, %r23;
    sub.f32 %f25, %f25, %f10;
    div.rn.f32 %f25, %f25, %f8;      // t = (yidx - yc) / fsy

    // w = mitchell(t)：两段都算，selp 选（无分支）
    abs.f32 %f26, %f25;              // a = |t|
    mul.f32 %f27, %f26, %f26;        // a2
    mul.f32 %f28, %f27, %f26;        // a3
    mul.f32 %f31, %f28, 0f3F955555;  // c1*a3
    fma.rn.f32 %f31, %f27, 0fC0000000, %f31;  // c2*a2
    add.f32 %f31, %f31, 0f3F638E39;  // + c3
    mul.f32 %f32, %f28, 0fBEC71C71;  // c4*a3
    fma.rn.f32 %f32, %f27, 0f40000000, %f32;  // c5*a2
    fma.rn.f32 %f32, %f26, 0fC0555555, %f32;  // c6*a
    add.f32 %f32, %f32, 0f3FE38E39;  // + c7
    setp.lt.f32 %p8, %f26, 0f3F800000;
    selp.f32 %f30, %f31, %f32, %p8;  // |t|<1 取一段，否则二段
    setp.ge.f32 %p16, %f26, 0f40000000;
    selp.f32 %f33, 0f00000000, %f30, %p16;  // |t|>=2 截断为 0

    // clamp yidx
    setp.lt.s32 %p9, %r23, 0;
    @%p9 mov.u32 %r23, 0;
    sub.u32 %r24, %r2, 1;
    setp.gt.u32 %p10, %r23, %r24;
    @%p10 mov.u32 %r23, %r24;

    mul.lo.u32 %r25, %r23, %r1;
    mul.wide.u32 %rd4, %r25, 4;
    add.u64 %rd4, %rd1, %rd4;        // 行首地址

    mov.u32 %r26, 0;                 // i
$L_LOOP_I:
    setp.ge.s32 %p11, %r26, %r17;
    @%p11 bra $L_END_I;

    // ---- wx ----
    add.s32 %r27, %r13, %r26;
    cvt.rn.f32.s32 %f34, %r27;
    sub.f32 %f34, %f34, %f9;
    div.rn.f32 %f34, %f34, %f7;      // t = (xidx - xc) / fsx

    abs.f32 %f35, %f34;
    mul.f32 %f36, %f35, %f35;
    mul.f32 %f37, %f36, %f35;
    mul.f32 %f38, %f37, 0f3F955555;
    fma.rn.f32 %f38, %f36, 0fC0000000, %f38;
    add.f32 %f38, %f38, 0f3F638E39;
    mul.f32 %f39, %f37, 0fBEC71C71;
    fma.rn.f32 %f39, %f36, 0f40000000, %f39;
    fma.rn.f32 %f39, %f35, 0fC0555555, %f39;
    add.f32 %f39, %f39, 0f3FE38E39;
    setp.lt.f32 %p12, %f35, 0f3F800000;
    selp.f32 %f46, %f38, %f39, %p12;
    setp.ge.f32 %p18, %f35, 0f40000000;
    selp.f32 %f40, 0f00000000, %f46, %p18; // wx

    // clamp xidx
    setp.lt.s32 %p13, %r27, 0;
    @%p13 mov.u32 %r27, 0;
    sub.u32 %r28, %r1, 1;
    setp.gt.u32 %p14, %r27, %r28;
    @%p14 mov.u32 %r27, %r28;

    mul.wide.u32 %rd5, %r27, 4;
    add.u64 %rd5, %rd4, %rd5;
    ld.global.v4.u8 {%rb1, %rb2, %rb3, %rb4}, [%rd5];
    cvt.u32.u8 %r40, %rb1;
    cvt.u32.u8 %r41, %rb2;
    cvt.u32.u8 %r42, %rb3;
    cvt.u32.u8 %r43, %rb4;
    cvt.rn.f32.u32 %f41, %r40;
    cvt.rn.f32.u32 %f42, %r41;
    cvt.rn.f32.u32 %f43, %r42;
    cvt.rn.f32.u32 %f44, %r43;

    mul.f32 %f45, %f40, %f33;        // w = wx * wy
    fma.rn.f32 %f20, %f41, %f45, %f20;
    fma.rn.f32 %f21, %f42, %f45, %f21;
    fma.rn.f32 %f22, %f43, %f45, %f22;
    fma.rn.f32 %f23, %f44, %f45, %f23;
    add.f32 %f24, %f24, %f45;

    add.u32 %r26, %r26, 1;
    bra $L_LOOP_I;
$L_END_I:

    add.u32 %r22, %r22, 1;
    bra $L_LOOP_J;
$L_END_J:

    // 归一化 + clamp + 写回
    setp.le.f32 %p15, %f24, 0f00000000;
    @%p15 bra $L_EXIT3;

    div.rn.f32 %f20, %f20, %f24;
    div.rn.f32 %f21, %f21, %f24;
    div.rn.f32 %f22, %f22, %f24;
    div.rn.f32 %f23, %f23, %f24;

    max.f32 %f20, %f20, 0f00000000;
    min.f32 %f20, %f20, 0f437F0000;
    max.f32 %f21, %f21, 0f00000000;
    min.f32 %f21, %f21, 0f437F0000;
    max.f32 %f22, %f22, 0f00000000;
    min.f32 %f22, %f22, 0f437F0000;
    max.f32 %f23, %f23, 0f00000000;
    min.f32 %f23, %f23, 0f437F0000;

    cvt.rni.u32.f32 %r50, %f20;
    cvt.rni.u32.f32 %r51, %f21;
    cvt.rni.u32.f32 %r52, %f22;
    cvt.rni.u32.f32 %r53, %f23;

    cvt.u8.u32 %rb1, %r50;
    cvt.u8.u32 %rb2, %r51;
    cvt.u8.u32 %rb3, %r52;
    cvt.u8.u32 %rb4, %r53;
    st.global.v4.u8 [%rd3], {%rb1, %rb2, %rb3, %rb4};

$L_EXIT3:
    ret;
}

// ===== 分离高斯：水平 =====
.visible .entry gauss_h(
    .param .u64 p_in,
    .param .u64 p_out,
    .param .u64 p_w,
    .param .u32 p_iw,
    .param .u32 p_ih,
    .param .u32 p_r
)
{
    .reg .pred %p<8>;
    .reg .u32 %r<32>;
    .reg .u64 %rd<16>;
    .reg .f32 %f<32>;
    .reg .b8 %rb<8>;

    ld.param.u64 %rd1, [p_in];
    ld.param.u64 %rd2, [p_out];
    ld.param.u64 %rd3, [p_w];
    ld.param.u32 %r1, [p_iw];
    ld.param.u32 %r2, [p_ih];
    ld.param.u32 %r3, [p_r];

    mov.u32 %r4, %ntid.x;
    mov.u32 %r5, %ctaid.x;
    mov.u32 %r6, %tid.x;
    mad.lo.u32 %r7, %r4, %r5, %r6;      // x

    mov.u32 %r8, %ntid.y;
    mov.u32 %r9, %ctaid.y;
    mov.u32 %r10, %tid.y;
    mad.lo.u32 %r11, %r8, %r9, %r10;    // y

    setp.ge.u32 %p1, %r7, %r1;
    @%p1 bra $L_EXIT4;
    setp.ge.u32 %p2, %r11, %r2;
    @%p2 bra $L_EXIT4;

    mov.f32 %f1, 0f00000000;
    mov.f32 %f2, 0f00000000;
    mov.f32 %f3, 0f00000000;
    mov.f32 %f4, 0f00000000;

    mov.s32 %r12, 0;                     // k 从 -r 开始
    sub.s32 %r14, %r12, %r3;
$L_LOOP_K:
    // k 从 -r 开始：用 %r14 = k
    setp.gt.s32 %p3, %r14, %r3;
    @%p3 bra $L_END_K;

    add.s32 %r15, %r7, %r14;             // x + k
    setp.lt.s32 %p4, %r15, 0;
    @%p4 mov.u32 %r15, 0;
    sub.u32 %r16, %r1, 1;
    setp.gt.u32 %p5, %r15, %r16;
    @%p5 mov.u32 %r15, %r16;

    // 权重下标 k + r
    add.s32 %r17, %r14, %r3;
    mul.wide.s32 %rd4, %r17, 4;
    add.u64 %rd4, %rd3, %rd4;
    ld.global.f32 %f5, [%rd4];

    mul.lo.u32 %r18, %r11, %r1;
    add.u32 %r18, %r18, %r15;
    mul.wide.u32 %rd5, %r18, 4;
    add.u64 %rd5, %rd1, %rd5;
    ld.global.v4.u8 {%rb1, %rb2, %rb3, %rb4}, [%rd5];
    cvt.u32.u8 %r20, %rb1;
    cvt.u32.u8 %r21, %rb2;
    cvt.u32.u8 %r22, %rb3;
    cvt.u32.u8 %r23, %rb4;
    cvt.rn.f32.u32 %f6, %r20;
    cvt.rn.f32.u32 %f7, %r21;
    cvt.rn.f32.u32 %f8, %r22;
    cvt.rn.f32.u32 %f9, %r23;

    fma.rn.f32 %f1, %f6, %f5, %f1;
    fma.rn.f32 %f2, %f7, %f5, %f2;
    fma.rn.f32 %f3, %f8, %f5, %f3;
    fma.rn.f32 %f4, %f9, %f5, %f4;

    add.s32 %r14, %r14, 1;
    bra $L_LOOP_K;
$L_END_K:

    mul.lo.u32 %r24, %r11, %r1;
    add.u32 %r24, %r24, %r7;
    mul.wide.u32 %rd6, %r24, 4;
    add.u64 %rd6, %rd2, %rd6;

