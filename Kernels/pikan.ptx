// ===== 分离高斯：垂直 =====
.visible .entry gauss_v(
    .param .u64 p_in,
    .param .u64 p_out,
    .param .u64 p_w,
    .param .u32 p_iw,
    .param .u32 p_ih,
    .param .u32 p_r
)
{
    .reg .pred %p<8>;
    .reg .u32 %r<32>;
    .reg .u64 %rd<16>;
    .reg .f32 %f<32>;
    .reg .b8 %rb<8>;

    ld.param.u64 %rd1, [p_in];
    ld.param.u64 %rd2, [p_out];
    ld.param.u64 %rd3, [p_w];
    ld.param.u32 %r1, [p_iw];
    ld.param.u32 %r2, [p_ih];
    ld.param.u32 %r3, [p_r];

    mov.u32 %r4, %ntid.x;
    mov.u32 %r5, %ctaid.x;
    mov.u32 %r6, %tid.x;
    mad.lo.u32 %r7, %r4, %r5, %r6;

    mov.u32 %r8, %ntid.y;
    mov.u32 %r9, %ctaid.y;
    mov.u32 %r10, %tid.y;
