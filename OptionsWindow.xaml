<Window x:Class="PIKAN.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选项"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#101216"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="OptTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#e8ecf4" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="OptDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#7f88a3" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="选项"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#f2f5fa"
                   Margin="0,0,0,12" />

        <ItemsControl Grid.Row="1" x:Name="List" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="全部启用" Width="86" Click="ActAll" Margin="0,0,8,0"
                    Foreground="#e8ecf4" Background="#2a2f3a" Height="30" BorderThickness="0" />
            <Button Content="确定" Width="86" Click="ActOk" IsDefault="True"
                    Foreground="#101216" Background="#4fd1c5" Height="30" BorderThickness="0" />
        </StackPanel>
    </Grid>
</Window>
