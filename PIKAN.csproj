<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PIKAN</AssemblyName>
    <RootNamespace>PIKAN</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <Company>JacquelineWu (flyercat)</Company>
    <Product>PIKAN</Product>
    <Description>PIKAN Windows 版 - 原生 HEIC/JPG 看图软件（ACDSee 风格）</Description>
    <Copyright>Copyright (c) 2026 JacquelineWu (flyercat)</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CUDA kernel 源码（PTX）：嵌入到程序集里，驱动在运行时 JIT 编译。
      用嵌入而不是复制到输出目录，是因为单文件 exe 里读不到附属文件；
      LoadPtx() 仍会先找 exe 旁边的 Kernels\pikan.ptx，方便直接调试/替换 kernel。
    -->
    <EmbeddedResource Include="Kernels\pikan.ptx" LogicalName="PIKAN.Kernels.pikan.ptx" />
  </ItemGroup>

  <!--
    日常开发：dotnet build  →  框架依赖的 PIKAN.exe（需本机装 .NET 10 桌面运行时）
    分发单文件（自包含，目标机无需装 .NET，约 66MB，需联网拉运行时包）：

      dotnet publish -c Release -r win-x64 /p:SelfContained=true
        /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true
        /p:EnableCompressionInSingleFile=true /p:DebugType=none /p:SatelliteResourceLanguages=en

    IncludeNativeLibrariesForSelfExtract 让 WPF 的 native 组件也进 exe，发布目录只有一个文件。
    注意：root namespace 下的 Kernels\pikan.ptx 是嵌入资源，单文件下照样读得到。
  -->

</Project>
