<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>

    <!-- 刻意关掉 Windows Forms：开它会带进 ~22 MB 的 WinForms 程序集（连它的设计器那几个），
         而且只要它在，MSBuild 就硬拦 trimming（error NETSDK1175）。项目原本只用它的三个 API
         ——双击间隔、屏幕工作区、文件夹对话框——现在都由 NativeWin32.cs 自己实现。 -->
    <UseWindowsForms>false</UseWindowsForms>
    <AssemblyName>PIKAN</AssemblyName>
    <RootNamespace>PIKAN</RootNamespace>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1</FileVersion>
    <Company>JacquelineWu (flyercat)</Company>
    <Product>PIKAN</Product>
    <Description>PIKAN Windows 版 - 原生 HEIC/JPG 看图软件（ACDSee 风格）</Description>
    <Copyright>Copyright (c) 2026 JacquelineWu (flyercat)</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CUDA kernel 源码（PTX）：嵌入到程序集里，驱动在运行时 JIT 编译。
      用嵌入而不是复制到输出目录，是因为单文件 exe 里读不到附属文件；
      LoadPtx() 仍会先找 exe 旁边的 Kernels\pikan.ptx，方便直接调试/替换 kernel。
    -->
    <EmbeddedResource Include="Kernels\pikan.ptx" LogicalName="PIKAN.Kernels.pikan.ptx" />
  </ItemGroup>

  <!--
    两种发布形态，一键出包（含签名）用 Publish.ps1：

      单文件  dist\PIKAN.exe   ← 分发用这个（pwsh .\Publish.ps1）
                dotnet publish -c Release -r win-x64 /p:SelfContained=true ^
                  /p:PublishSingleFile=true /p:IncludeNativeLibrariesForSelfExtract=true ^
                  /p:EnableCompressionInSingleFile=true /p:DebugType=none ^
                  /p:SatelliteResourceLanguages=en -o dist

      便携目录 portable\        ← 多文件，调试/对照用（pwsh .\Publish.ps1 -Portable）

    曾经放弃过单文件：那时的实现要把 WPF 的 native 组件自解压到 %TEMP%，
    被安全软件或目录权限一拦就是「双击毫无反应」的静默退出（本机复现过 Error code: 5）。
    .NET 10 重测已不成立：SingleFile 的 native 库直接从 bundle 里加载，
    跑完之后 %TEMP%/.net/ 下没有生成任何提取目录，bench（58 张图 + GPU 重采样）照常跑完。
    所以现在单文件是首选形态，便携目录退居调试/兜底。

    ★ 别再试 PublishTrimmed 了（2026-10-30 实测，两次都失败）：
      1. SDK 硬拦：UseWindowsForms → NETSDK1175；即便关掉 WinForms，UseWPF → NETSDK1168。
         后门是 -p:_SuppressWpfTrimError=true（见 Microsoft.NET.RuntimeIdentifierInference.targets），
         确实能编译通过，156 MB → 45 MB，看着很美；
      2. 但跑起来必崩：WPF 的 XAML 引擎在 DeferredLoad 时用 Activator.CreateInstance 反射
         创建 System.Windows.TemplateContentLoader，trimmer 看不见这次反射，把构造函数裁掉了 ——
         MainWindow.InitializeComponent() 直接抛 MissingMethodException，连窗口都出不来。
      这是 XAML 引擎的固有行为，改不了。想靠 TrimmerRootAssembly 全场保留等于不 trim，没意义。

    Kernels\pikan.ptx 是嵌入资源，两种形态都读得到。
  -->

</Project>
