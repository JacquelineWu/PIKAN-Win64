<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PIKAN</AssemblyName>
    <RootNamespace>PIKAN</RootNamespace>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0</FileVersion>
    <Company>JacquelineWu (flyercat)</Company>
    <Product>PIKAN</Product>
    <Description>PIKAN Windows 版 - 原生 HEIC/JPG 看图软件（ACDSee 风格）</Description>
    <Copyright>Copyright (c) 2026 JacquelineWu (flyercat)</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CUDA kernel 源码（PTX）：嵌入到程序集里，驱动在运行时 JIT 编译。
      用嵌入而不是复制到输出目录，是因为单文件 exe 里读不到附属文件；
      LoadPtx() 仍会先找 exe 旁边的 Kernels\pikan.ptx，方便直接调试/替换 kernel。
    -->
    <EmbeddedResource Include="Kernels\pikan.ptx" LogicalName="PIKAN.Kernels.pikan.ptx" />
  </ItemGroup>

  <!--
    日常开发：dotnet build  →  框架依赖的 PIKAN.exe（需本机装 .NET 10 桌面运行时）

    分发：只出「便携版」（自包含多文件目录 portable\）。曾经也发过单文件 exe，已弃用：
    WPF 的 native 组件进不了 bundle，靠运行时自解压到临时目录，一旦被安全软件或目录权限
    拦住就是「双击毫无反应」的静默退出（本机复现过 Error code: 5）。便携版不做自解压，更稳。

      dotnet publish -c Release -r win-x64 /p:SelfContained=true -p:PublishSingleFile=false ^
        -p:DebugType=none -p:SatelliteResourceLanguages=en -o portable

    一键出包（含签名）用 Publish.ps1。Kernels\pikan.ptx 是嵌入资源，任何形态都读得到。
  -->

  <PropertyGroup>
    <!-- 锁死：避免哪天手滑 publish 出单文件 exe -->
    <PublishSingleFile>false</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

</Project>
